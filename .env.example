# GEMINI_API_KEY: Optional for Gemini AI calls. The app uses local matching if unavailable.
# Configure this through a local secret or environment variable; never commit a real key.
GEMINI_API_KEY="your_gemini_api_key_here"
USE_GEMINI_API=false
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL=openrouter/free
USE_OPENROUTER_API=false
AGENTROUTER_API_KEY="your_agentrouter_api_key_here"
AGENTROUTER_API_URL="https://api.agentrouter.com/v1/chat/completions"
AGENTROUTER_MODEL="gpt-4o-mini"
USE_AGENTROUTER_API=false

# APP_URL: The public URL where this app is hosted. For local development, use localhost.
APP_URL="http://localhost:3000"

# Database connection settings. Use MySQL or MariaDB in production, or SQLite fallback when DB_HOST is missing.
# On Railway, link a MySQL service and the app will automatically use its MYSQLHOST,
# MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, and MYSQLDATABASE variables. Do not set USE_SQLITE in production.
# Alternatively set MYSQL_URL (or a mysql:// DATABASE_URL) supplied by Railway.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillsconnect_db
# Preferred when importing a single Railway connection value into a host:
# MYSQL_URL="mysql://user:password@host:port/database"
# Set only if your provider requires a TLS database connection.
DB_SSL=false
USE_SQLITE=false

# JWT authentication secret. Set a strong random string for production.
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Paystack settings for payment integration. Use pk_test_/sk_test_ keys locally and
# in a defense deployment. Use live keys only after the business account is ready.
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"
PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"
NEXT_PUBLIC_PAYSTACK="https://api.paystack.co"

# Application public URL used in email links and redirects.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public counters ignore imported/demo rows before this launch date.
PUBLIC_STATS_START_DATE="2026-08-19"

# Email SMTP settings for notifications and verification emails.
# Recommended free production-ready providers: SendGrid or Zoho Mail.
# For SendGrid, use:
# EMAIL_HOST="smtp.sendgrid.net"
# EMAIL_PORT=587
# EMAIL_USER="apikey"
# EMAIL_PASS="your_sendgrid_api_key_here"
#
# For Zoho Mail, use:
# EMAIL_HOST="smtp.zoho.com"
# EMAIL_PORT=587
# EMAIL_USER="skillsconnectgh@zohomail.com"
# EMAIL_PASS="your_zoho_app_password_here"
# EMAIL_FROM="SkillsConnect Ghana <no-reply@skillsconnectghana.com>"

# Path where uploaded files are stored. Relative to the project root.
UPLOAD_DIR="./public/uploads"
